# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# App
APP_ENV=development
APP_NAME=Jarvis Business Assistant
CORS_ORIGINS=http://localhost:3000,https://www.anthonywarrenmckinzy.com,https://anthonywarrenmckinzy.com
LOG_LEVEL=INFO

# Brand / knowledge sites
PRIMARY_WEBSITE=https://www.anthonywarrenmckinzy.com
KNOWLEDGE_WEBSITE=https://www.759inc.blue

# RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.7

# Storage
STORAGE_BUCKET=documents

# Optional research
ENABLE_WEB_RESEARCH=true
SERPER_API_KEY=

# ZeroClaw channel bridge (WhatsApp / Telegram transport → L.U.C.E.R.O brain)
ENABLE_CHANNEL_BRIDGE=false
LUCERO_CHANNEL_API_KEY=change-me-generate-a-long-secret
CHANNEL_DEFAULT_USER_ID=
CHANNEL_DEFAULT_AGENT=support
CHANNEL_ALLOWED_NUMBERS=
