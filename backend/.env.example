# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# App
APP_ENV=production
APP_NAME=L.U.C.E.R.O Business Partner
CORS_ORIGINS=https://lucero-zeta.vercel.app,https://www.anthonywarrenmckinzy.com,https://anthonywarrenmckinzy.com
LOG_LEVEL=INFO

# Brand / knowledge sites
PRIMARY_WEBSITE=https://www.anthonywarrenmckinzy.com
KNOWLEDGE_WEBSITE=https://www.759inc.blue

# RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.7

# Storage
STORAGE_BUCKET=documents

# Resend (free tier) — transactional email
RESEND_API_KEY=
EMAIL_FROM=L.U.C.E.R.O <onboarding@resend.dev>
# Background reminder poll interval (seconds). Set 0 to disable.
REMINDER_POLL_SECONDS=60

# Optional research
ENABLE_WEB_RESEARCH=true
SERPER_API_KEY=

# ZeroClaw channel bridge (WhatsApp / Telegram transport → L.U.C.E.R.O brain)
ENABLE_CHANNEL_BRIDGE=false
LUCERO_CHANNEL_API_KEY=change-me-generate-a-long-secret
CHANNEL_DEFAULT_USER_ID=
CHANNEL_DEFAULT_AGENT=support
# Leave empty to reply to ALL customers who message the linked business WhatsApp.
# Set comma-separated E.164 numbers only if you want a hard allowlist instead.
CHANNEL_ALLOWED_NUMBERS=
