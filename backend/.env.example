# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# OpenRouter (Qwen 3 primary, DeepSeek fallback)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=qwen/qwen3.7-plus
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# App
APP_ENV=production
APP_NAME=L.U.C.E.R.O Business Partner
CORS_ORIGINS=https://lucero-iota.vercel.app,https://lucero-zeta.vercel.app,http://localhost:3000,https://www.anthonywarrenmckinzy.com,https://anthonywarrenmckinzy.com
LOG_LEVEL=INFO

# Brand / knowledge sites
PRIMARY_WEBSITE=https://www.anthonywarrenmckinzy.com
KNOWLEDGE_WEBSITE=https://www.759inc.blue

# RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.7

# Storage
STORAGE_BUCKET=documents
GENERATED_STORAGE_BUCKET=generated-assets

# Resend (free tier) — transactional email
RESEND_API_KEY=
EMAIL_FROM=L.U.C.E.R.O <onboarding@resend.dev>
# Background reminder poll interval (seconds). Set 0 to disable.
REMINDER_POLL_SECONDS=60
# AI OS job poller (seconds). Set 0 to disable.
JOB_POLL_SECONDS=5

# Web research — Tavily preferred, then Serper, then DuckDuckGo
ENABLE_WEB_RESEARCH=true
TAVILY_API_KEY=
SERPER_API_KEY=

# Replicate — images (FLUX/SDXL), video (Wan/CogVideoX), Kokoro TTS, Whisper STT
REPLICATE_API_TOKEN=
REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell
REPLICATE_SDXL_MODEL=stability-ai/sdxl
REPLICATE_WAN_MODEL=wan-video/wan-2.2-t2v-fast
REPLICATE_COGVIDEOX_MODEL=thomashayden/cogvideox-5b
REPLICATE_KOKORO_MODEL=jaaari/kokoro-82m
REPLICATE_WHISPER_MODEL=openai/whisper
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan
REPLICATE_REMOVE_BG_MODEL=cjwbw/rembg

# ZeroClaw channel bridge (WhatsApp / Telegram transport → L.U.C.E.R.O brain)
ENABLE_CHANNEL_BRIDGE=false
LUCERO_CHANNEL_API_KEY=change-me-generate-a-long-secret
CHANNEL_DEFAULT_USER_ID=
CHANNEL_DEFAULT_AGENT=support
CHANNEL_ALLOWED_NUMBERS=
